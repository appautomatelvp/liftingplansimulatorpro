{
  "compilerOptions": {
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@domain/*": ["src/domain/*"],
      "@shared/*": ["src/shared/*"],
      "@ui/*": ["src/ui/*"],
      "@sim/*": ["src/sim/*"],
      "@content/*": ["src/content/*"]
    }
  },
  "include": ["src/**/*.js", "test/**/*.js"],
  "exclude": ["dist", "node_modules"]
}
