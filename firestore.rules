rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function activeAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'admin'
        && get(userPath(request.auth.uid)).data.status == 'active';
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || activeAdmin());
      allow list: if activeAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'tier', 'createdAt', 'lastLogin', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'tier', 'createdAt', 'lastLogin', 'status'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.tier == 'free'
        && request.resource.data.status == 'active';

      // Account holders can only change their sign-in metadata. They cannot grant themselves access.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']);

      // Admins may manage tier/status only; role assignment is reserved for trusted provisioning.
      allow update: if activeAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tier', 'status'])
        && request.resource.data.tier in ['free', 'premium']
        && request.resource.data.status in ['active', 'locked', 'banned'];

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
