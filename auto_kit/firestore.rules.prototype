// RULES CHO APP ĐANG TEST (prototype) — CHO PHÉP đăng nhập ẩn danh.
// CẢNH BÁO: ai có link app cũng đọc/ghi được dữ liệu. CHỈ dùng với dữ liệu giả/thử nghiệm.
// Trước khi có khách thật: chuyển sang firestore.rules (production) và đặt VITE_APP_ENV=production.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/{document=**} { allow read, write: if request.auth != null; }
    match /projects/{tenantId}/{document=**} { allow read, write: if request.auth != null; }
    match /{document=**} { allow read, write: if false; }
  }
}
